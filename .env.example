# --- API-FOOTBALL (direct via API-Sports dashboard) ---
# Get a free key at https://dashboard.api-football.com/register
# then find it under Account > My Access
APISPORTS_KEY=your_api_sports_key_here

# --- Twilio (SMS) ---
# Get free trial credentials at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Server ---
PORT=3000

# How often (in seconds) the server checks tracked matches for updates
POLL_INTERVAL_SECONDS=60